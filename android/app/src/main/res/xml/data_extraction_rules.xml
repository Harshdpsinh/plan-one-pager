<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing from this app is included in cloud backup or device-to-device transfer.

  The app holds statement passwords and financial documents. The encrypted password store is
  bound to a Keystore key that cannot leave the device anyway, so a backup copy would be
  useless ciphertext; excluding everything makes the intent explicit rather than incidental.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
